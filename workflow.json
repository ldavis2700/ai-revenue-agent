{
  "name": "Autonomous Revenue Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "c1f7b8a1-7d1a-4d22-b8d9-2e02f10b0001",
      "name": "1-Hour Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "/opt/venv/bin/python3 /files/scripts/fetch_leads.py | /opt/venv/bin/python3 /files/scripts/revenue_cycle.py > /tmp/revenue-cycle.json && /opt/venv/bin/python3 /files/autonomous_cycle.py"
      },
      "id": "c1f7b8a1-7d1a-4d22-b8d9-2e02f10b0002",
      "name": "Run Revenue Cycle",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "const result = JSON.parse($input.first().json.stdout || '{}');\nconst ready = result.autonomous_dispatch || [];\nreturn ready.map(lead => ({ json: { ...lead, run_metrics: result.metrics || {} } }));"
      },
      "id": "c1f7b8a1-7d1a-4d22-b8d9-2e02f10b0003",
      "name": "Emit Autonomous Consented Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    }
  ],
  "connections": {
    "1-Hour Cron Trigger": {
      "main": [
        [
          {
            "node": "Run Revenue Cycle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Revenue Cycle": {
      "main": [
        [
          {
            "node": "Emit Autonomous Consented Actions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
