FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pil ffmpeg fonts-dejavu-core util-linux ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home apex
WORKDIR /app
COPY content_worker.py ./
COPY runtime_supervisor.py revenue_worker.py autonomous_cycle.py delivery_adapter.py dispatch_recovery.py free_delivery_policy.py ./
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY content/jobs/ ./content/jobs/
COPY sales/*.html ./sales/
COPY sales/robots.txt sales/sitemap.xml ./sales/
COPY content-entrypoint.sh ./
RUN chmod 755 /app/content-entrypoint.sh
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 CONTENT_STATE_DIR=/data/content PORT=8080
EXPOSE 8080
CMD ["/app/content-entrypoint.sh"]
